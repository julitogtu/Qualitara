# Copy to .env (gitignored) to override. Every value here is for LOCAL DEVELOPMENT ONLY.

# SA password for the SQL Server container. Must meet SQL Server complexity rules
# (8+ chars, 3 of: upper, lower, digit, symbol). The default below is public — dev only.
MSSQL_SA_PASSWORD=DevOnly_Relay_2026!

# Host port mapped to the container's 1433.
MSSQL_PORT=1433

# The API reads its connection string from configuration key ConnectionStrings:Relay.
# appsettings.Development.json carries a matching dev default. If you change the password
# or port above, override it for the API with an environment variable, e.g.:
# ConnectionStrings__Relay=Server=localhost,1433;Database=RelayPulse;User Id=sa;Password=<your password>;Encrypt=True;TrustServerCertificate=True
