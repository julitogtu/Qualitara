# Copy to .env (gitignored) to override. Every value here is for LOCAL DEVELOPMENT ONLY.
# `docker compose up --build` works without a .env: each value below is also the compose default.

# SA password for the SQL Server container. Must meet SQL Server complexity rules
# (8+ chars, 3 of: upper, lower, digit, symbol). The default below is public — dev only.
# The seed and api containers build their connection string from this value.
MSSQL_SA_PASSWORD=DevOnly_Relay_2026!

# Host port mapped to the container's 1433 (used by local `dotnet run` and tools).
MSSQL_PORT=1433

# Database name the seed and api containers use.
MSSQL_DATABASE=RelayPulse

# Host port for the web container (nginx: Angular build + /api proxy).
# Open http://localhost:8080/accounts/6/week/2026-06-01
WEB_PORT=8080

# Local dev only (dotnet run): the API reads ConnectionStrings:Relay, which
# appsettings.Development.json sets to match the defaults above. If you change the password
# or port, override it with an environment variable, e.g.:
# ConnectionStrings__Relay=Server=localhost,1433;Database=RelayPulse;User Id=sa;Password=<your password>;Encrypt=True;TrustServerCertificate=True
